// Multi-tenant ordering platform — Prisma schema (PostgreSQL)
// Status/method-style fields are plain Strings; allowed values are enforced in
// the app layer (Zod + TS union types) to keep the model simple and portable.
//
// Tenant isolation: every tenant-scoped table carries its own `tenantId`
// directly (not just via a parent relation), so queries can filter by it at
// the top level instead of relying on a join chain to prove ownership.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String    @id @default(cuid())
  slug         String    @unique
  businessName String
  logoUrl      String?
  accentColor  String?
  /// IANA timezone (e.g. "Asia/Ulaanbaatar") this business operates in.
  /// Everything that needs to know "what day is it right now" for this
  /// tenant — closed-date checks in particular — must go through this
  /// instead of the server's own clock (UTC on Vercel), which otherwise
  /// disagrees with the tenant's actual calendar day for hours at a time.
  timezone     String    @default("UTC")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  adminUsers      AdminUser[]
  branches        Branch[]
  categories      MenuCategory[]
  items           MenuItem[]
  timeSlots       TimeSlot[]
  orders          Order[]
  modifierGroups  ModifierGroup[]
  modifierOptions ModifierOption[]
  branchClosures  BranchClosure[]
}

model AdminUser {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String   @unique
  passwordHash  String
  /// Signup email verification. Not enforced (an unverified admin can still
  /// use their site) — this platform can't yet guarantee outbound email
  /// reaches an arbitrary tenant's inbox (no verified sending domain), so
  /// blocking on it would risk locking self-serve signups out entirely.
  /// It's a nudge (see AuthToken), not a gate.
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  authTokens AuthToken[]
}

/// type: "EMAIL_VERIFICATION" | "PASSWORD_RESET"
model AuthToken {
  id          String    @id @default(cuid())
  token       String    @unique
  type        String
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId, type])
}

model Branch {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String
  phone     String
  hours     String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  timeSlots TimeSlot[]
  orders    Order[]
  closures  BranchClosure[]

  @@unique([tenantId, name])
}

model MenuCategory {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     MenuItem[]

  @@unique([tenantId, name])
}

model MenuItem {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  price       Int
  description String?
  imageUrl    String?
  isAvailable Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orderItems     OrderItem[]
  modifierGroups ModifierGroup[]
}

/// A named set of choices attached to one menu item (e.g. "Size", "Spice
/// Level", "Add-ons") — not shared across items, so a business re-creates a
/// similar group per item rather than picking from a reusable library. Keeps
/// both the data model and the admin UI simple; worth revisiting only if
/// duplication across many items becomes a real complaint.
///
/// minSelect/maxSelect generalize "pick exactly one" (1/1), "pick one or
/// skip" (0/1), and "pick up to N" (0/N) without a separate required flag or
/// a single-vs-multiple enum.
model ModifierGroup {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  minSelect  Int      @default(0)
  maxSelect  Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  options ModifierOption[]
}

model ModifierOption {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  priceDelta      Int           @default(0)
  isAvailable     Boolean       @default(true)
  sortOrder       Int           @default(0)

  orderItemModifiers OrderItemModifier[]
}

/// A restaurant closing for a specific calendar date (holiday, one-off
/// closure) without touching its recurring weekly time-slot list.
model BranchClosure {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([branchId, date])
  @@index([tenantId, branchId])
}

/// method: "PICKUP" | "DELIVERY"
model TimeSlot {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  method    String
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

/// diningMethod: "DINE_IN" | "PICKUP" | "DELIVERY"
/// status: "PENDING" | "COMPLETED" | "CANCELLED"
/// paymentMethod: "CASH" | "TRANSFER"
model Order {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNo         String
  branchId        String
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diningMethod    String
  status          String      @default("PENDING")
  tableNumber     String?
  timeSlotId      String?
  timeSlot        TimeSlot?   @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  deliveryAddress String?
  notes           String?
  paymentMethod   String
  totalAmount     Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([createdAt])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String?
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  nameSnapshot  String
  priceSnapshot Int
  quantity      Int
  subtotal      Int

  modifiers OrderItemModifier[]
}

/// A snapshot of one selected modifier option at order time — preserved even
/// if the option is later edited/deleted, same rationale as
/// OrderItem.nameSnapshot/priceSnapshot for the base item.
model OrderItemModifier {
  id                 String          @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOptionId   String?
  modifierOption     ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)
  groupNameSnapshot  String
  nameSnapshot       String
  priceDeltaSnapshot Int
}
